    "token_limit": {
      "enabled": false,
      "limit": 8000,
      "encoding": "cl100k_base",
      "mode": "block"
    },
    "pii": {
      "enabled": false,
      "input_mode": "redact",
      "untrusted_mode": "mask",
      "output_mode": "flag",
      "restore": true
    },
    "secrets": {
      "enabled": false,
      "redact": "all"
    }
